# ==============================================================================
# SISTEMA DE INFORMACIÓN GEORREFERENCIADA PARA EL CULTIVO DE ARROZ (SIG-ARROZ)
# Plantilla de Variables de Entorno del Backend Django (.env.example)
# Estándar de Gestión de Configuración CR-008 / IEEE 828:2022
# ==============================================================================
# Instrucciones:
# 1. Copie este archivo como '.env': cp .env.example .env (o Copy-Item .env.example .env en PowerShell)
# 2. Reemplace los valores de ejemplo por sus credenciales locales o de producción.
# 3. NUNCA suba el archivo '.env' con secretos reales al repositorio de control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN DE SEGURIDAD Y DJANGO CORE
# ------------------------------------------------------------------------------
# Clave criptográfica de Django (genere una aleatoria de al menos 50 caracteres)
SECRET_KEY=coloca_aqui_tu_django_secret_key_aleatoria

# Modo de depuración (True para desarrollo local, False estricto en producción)
DEBUG=True

# Lista de hosts permitidos separados por comas
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (POSTGRESQL O SQLITE)
# ------------------------------------------------------------------------------
# Opción A (Recomendada para Producción en la nube: Neon, Railway, Supabase):
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgresql://tu_usuario:tu_password@tu-host-de-base-de-datos.neon.tech:5432/neondb

# Opción B (Variables desagregadas si no se utiliza DATABASE_URL):
# Nota: Si DATABASE_URL y DB_HOST están comentados o vacíos, Django utilizará automáticamente
# una base de datos local SQLite (db.sqlite3) ideal para pruebas rápidas de desarrollo.
DB_HOST=tu-host-de-base-de-datos.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=tu_usuario
DB_PASSWORD=tu_password_segura

# ------------------------------------------------------------------------------
# 3. POLÍTICA DE SEGURIDAD CORS (CROSS-ORIGIN RESOURCE SHARING)
# ------------------------------------------------------------------------------
# Orígenes web autorizados para interactuar con la API (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://sig-arroz-frontend.vercel.app

# ------------------------------------------------------------------------------
# 4. SERVIDOR DE CORREOS ELECTRÓNICOS (SMTP / BREVO)
# ------------------------------------------------------------------------------
# Parámetros para recuperación de contraseñas y notificaciones del sistema
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_cuenta_verificada@correo.com
EMAIL_HOST_PASSWORD=tu_password_smtp
DEFAULT_FROM_EMAIL=SIG-ARROZ Soporte <no-reply@sig-arroz.com>
BREVO_API_KEY=tu_api_key_de_brevo
